# Copy to .env (or scripts/.env.demo for the demo script) and fill in.
# NEVER commit a real private key. Use testnet-only wallets.

# QDay Aevum testnet RPC (chain 44005)
AEVUM_RPC_URL=https://rpc-test.qday.info

# Deployer / demo owner private key (testnet wallet funded via the QDay faucet).
# The garap demo wallet used for this submission's deployment is documented in the README.
DEPLOYER_PRIVATE_KEY=
OWNER_PRIVATE_KEY=

# Filled in after deployment (see README > Deployment)
MANDATEPAY_ADDRESS=

# Optional demo overrides
AGENT_PRIVATE_KEY=
PAYEE_ADDRESS=
TOKEN=0x456569838f1d43009A91ebA4263147Afd7233483
